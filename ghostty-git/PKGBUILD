# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: kaij <contact at kaij dot tech>

_pkgbase=ghostty
pkgname=($_pkgbase-git $_pkgbase-shell-integration-git $_pkgbase-terminfo-git $_pkgbase-nautilus-git)
pkgrel=2
pkgver=1.3.1.r1554.g1d1c83f
pkgdesc="Fast, native, feature-rich terminal emulator pushing modern features (GTK accessibility branch)"
arch=(x86_64 aarch64 i686)
url="https://github.com/ghostty-org/$_pkgbase"
license=(MIT)

# Build the GTK accessibility branch from the fork rather than upstream main.
# Keep this branch pushed: makepkg builds whatever GitHub has, not the local
# working tree.
_repo="https://github.com/alex19EP/$_pkgbase.git"
_branch="gtk-accessibility-poc"
# Distinct checkout name so this doesn't collide with the upstream-URL clone
# makepkg may already have cached under $SRCDEST/ghostty.
_srcname="$_pkgbase-a11y"
depends=(bzip2
         fontconfig libfontconfig.so
         freetype2 libfreetype.so
         glibc # libc.so libm.so
         glib2 libglib-2.0.so libgio-2.0.so libgobject-2.0.so
         gtk4 libgtk-4.so
         gtk4-layer-shell
         libx11 # libX11.so
         harfbuzz libharfbuzz.so
         libadwaita libadwaita-1.so
         libpng
         oniguruma # libonig.so
         pixman
         wayland libwayland-client.so
         zlib)
makedepends=(blueprint-compiler
             git
             pandoc-cli
             'zig')
source=("$_srcname::git+$_repo#branch=$_branch"
        ghostty-llvm.patch)
sha256sums=('SKIP'
            'af82aafe8f6a6de6ae61ad1c4badef6d4cd08d4a23e3cffe8572d5f90ebef574')

prepare() {
	cd "$_srcname"
	# https://github.com/ghostty-org/ghostty/discussions/11993#discussioncomment-17336660
	patch -p1 -i ../ghostty-llvm.patch
	ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache/" ./nix/build-support/fetch-zig-cache.sh
}

pkgver() {
	cd "$_srcname"
	git describe --long --tags --abbrev=7 --match="v*" HEAD |
		sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd "$_srcname"
	# Zig 0.16 stores fetched packages in the global cache as .tar.gz files,
	# but `--system <dir>` still expects extracted package directories, so it
	# can no longer consume the cache prepare() populates. Point Zig at that
	# cache directly and enable each system integration by hand instead --
	# these are exactly the ones `--system` used to turn on by default, and
	# they are what the depends=() list above reflects. -fsys=fontconfig in
	# particular is mandatory: a statically linked fontconfig alongside GTK's
	# system one corrupts the shared font cache and crashes in FcFontSort.
	DESTDIR=build ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache" zig build \
		--summary all \
		--prefix "/usr" \
		-fsys=fontconfig \
		-fsys=freetype \
		-fsys=harfbuzz \
		-fsys=libpng \
		-fsys=oniguruma \
		-fsys=zlib \
		-fsys=gtk4-layer-shell \
		-Doptimize=ReleaseFast \
		-Dgtk-x11=true \
		-Dcpu=baseline \
		-Dpie=true \
		-Demit-docs \
		-Dversion-string="${pkgver%.r*}-r${pkgver#*.r}-$pkgrel-arch" \
		--build-id=sha1
}

package_ghostty-git() {
	depends+=("${_pkgbase}"-shell-integration-git
	          "${_pkgbase}"-terminfo-git)
	provides=("${pkgname%-git}=$pkgver")
	conflicts=(${pkgname%-git})
	optdepends+=("ghostty-nautilus: Open in Ghostty context menu in GNOME Files")
	cd "$_srcname"
	cp -a build/* "$pkgdir/"
	install -Dm0644 -t "${pkgdir}/usr/share/licenses/$pkgname/" LICENSE
	rm -r "$pkgdir"/usr/share/terminfo
	rm -r "$pkgdir"/usr/share/ghostty/shell-integration
}

package_ghostty-shell-integration-git() {
	pkgdesc='Shell integration scripts for ghostty'
	depends=()
	provides=("${pkgname%-git}=$pkgver")
	conflicts=(${pkgname%-git})
	cd "$_srcname"
	mkdir -p "$pkgdir/usr/share/ghostty/shell-integration"
	cp -r build/usr/share/ghostty/shell-integration/* "$pkgdir/usr/share/ghostty/shell-integration/"
}

package_ghostty-terminfo-git() {
	pkgdesc='Terminfo for ghostty'
	depends=()
	provides=("${pkgname%-git}=$pkgver")
	conflicts=(${pkgname%-git})
	cd "$_srcname"
	mkdir -p "$pkgdir/usr/share/terminfo"
	cp -r build/usr/share/terminfo/* "$pkgdir/usr/share/terminfo/"
	# ncurses >= 6.6 ships the `ghostty` entry itself, so keeping our copy
	# here is a file conflict. Only xterm-ghostty is ours to install --
	# extra/ghostty-terminfo dropped the same file for this reason.
	rm -r "$pkgdir/usr/share/terminfo/g"
}

package_ghostty-nautilus-git() {
	pkgdesc='Open in Ghostty for GNOME Files'
	depends=(ghostty nautilus-python)
	provides=("${pkgname%-git}=$pkgver")
	conflicts=(${pkgname%-git})
	# Unlike the rest of ghostty, the nautilus extension is GPL-2.0-or-later
	# because nautilus-python itself is GPL-2 as well.
	license=(GPL-2.0-or-later)
	cd "$_srcname"
	mkdir -p "$pkgdir"/usr/share/nautilus-python/
	cp -r build/usr/share/nautilus-python/* "$pkgdir"/usr/share/nautilus-python/
}
